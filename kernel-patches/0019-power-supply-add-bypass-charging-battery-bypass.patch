+/*
+ * Halium/UT: battery bypass ("direct USB power").
+ *
+ * When enabled the main charger is disabled, so the battery is neither
+ * charged nor discharged - the system runs from the USB/DC input. The
+ * battery properties are faked (present/full/healthy) so that userspace
+ * (upower, repowerd, lomiri) never shuts the device down because of a
+ * missing or empty battery.
+ */
+int smblib_get_prop_bypass_charging(struct smb_charger *chg,
+				    union power_supply_propval *val)
+{
+	val->intval = chg->bypass_charging;
+	return 0;
+}
+
+int smblib_set_prop_bypass_charging(struct smb_charger *chg,
+				    const union power_supply_propval *val)
+{
+	int rc;
+
+	chg->bypass_charging = !!val->intval;
+	rc = vote(chg->chg_disable_votable, BYPASS_CHARGING_VOTER,
+		  chg->bypass_charging, 0);
+	if (rc < 0)
+		smblib_err(chg, "Couldn't %s battery bypass rc=%d\n",
+			   chg->bypass_charging ? "enable" : "disable", rc);
+	else
+		pr_info("Battery bypass %s\n",
+			chg->bypass_charging ? "enabled" : "disabled");
+
+	power_supply_changed(chg->batt_psy);
+
+	return rc;
+}
+
 int smblib_set_prop_batt_status(struct smb_charger *chg,
 				  const union power_supply_propval *val)
 {
