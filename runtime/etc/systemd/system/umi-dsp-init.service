[Unit]
Description=umi: expose DSP firmware and boot adsp/cdsp
DefaultDependencies=no
After=local-fs.target mount-android-partitions.service mount-android-system.service
Before=lxc-android-config.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/umi-dsp-init.sh

[Install]
WantedBy=sysinit.target
